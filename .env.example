# Copy to .env and fill in. All values are required.
# Generate secrets with e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Neo4j superuser: used only by the neo4j and init containers (schema + import).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Least-privilege account created by init.sh and used by the API.
NEO4J_APP_USER=app
NEO4J_APP_PASSWORD=change-me-too

# Key for signing login tokens (JWT).
JWT_SECRET=change-me-long-random
